-- ==========================================
-- MOTOR PRINCIPAL & LÓGICA DE COMBATE
-- ==========================================
local FLIGHT_SPEED = 50 
local UNDERGROUND_Y = -5 -- Altura subterrânea segura (longe do void)

local autoPunchActive = false
local engineRunning = false
local priorityTarget = nil
local noclipConnection = nil
local currentTween = nil
local antiSeatConnection = nil

local function ToggleNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end
    else
        if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    end
end

-- Impedir que o jogador sente em carros
local function setupAntiSeat()
    if antiSeatConnection then antiSeatConnection:Disconnect() end
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            antiSeatConnection = hum.Seated:Connect(function(isSeated)
                if isSeated then
                    hum.Sit = false
                end
            end)
        end
    end
end

-- Agachamento remoto (sem afetar a tela do usuário)
local function setRemoteCrouch(state)
    pcall(function()
        local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
        local crouchRemote = ReplicatedStorage:FindFirstChild("Crouch") or (remotesFolder and remotesFolder:FindFirstChild("Crouch"))
        if crouchRemote then
            crouchRemote:FireServer(state)
        end
    end)
end

-- Verifica se o alvo está em um carro
local function isInCar(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if hum and (hum.Sit or (hum.SeatPart and hum.SeatPart:IsA("VehicleSeat"))) then
        return true
    end
    return false
end

-- Verifica se o alvo está pulando
local function isJumping(hum)
    if not hum then return false end
    local state = hum:GetState()
    return state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or hum.FloorMaterial == Enum.Material.Air
end

local function isValidTarget(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end 
    if plr.Character:FindFirstChildOfClass("ForceField") then return false end
    if isInCar(plr) then return false end 
    return true
end

local function getClosestTarget(pos)
    local bestTarget = nil
    local minDist = math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isValidTarget(p) then
            local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
            if pHrp then
                local dist = (pHrp.Position - pos).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestTarget = p
                end
            end
        end
    end
    return bestTarget
end

-- Função de Soco via Remote exato do Prison Life
local function doPunch(target)
    pcall(function()
        local meleeEvent = ReplicatedStorage:FindFirstChild("meleeEvent") or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("meleeEvent"))
        if meleeEvent and target and target.Character then
            meleeEvent:FireServer(target, 1, 1)
        end
    end)
end

-- Sistema de Tween por Velocidade (Sem Teleporte)
local function tweenTo(proxy, destCFrame)
    if currentTween then currentTween:Cancel() end
    local dist = (proxy.Position - destCFrame.Position).Magnitude
    local timeVal = dist / FLIGHT_SPEED
    if timeVal < 0.05 then timeVal = 0.05 end

    local tweenInfo = TweenInfo.new(timeVal, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
    currentTween = TweenService:Create(proxy, tweenInfo, {CFrame = destCFrame})
    currentTween:Play()
    
    local startTime = tick()
    while currentTween.PlaybackState == Enum.PlaybackState.Playing and (tick() - startTime) < (timeVal + 0.1) do
        RunService.Heartbeat:Wait()
    end
end

local function startEngine()
    if engineRunning then return end
    engineRunning = true
    
    task.spawn(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then engineRunning = false return end

        local originalPos = hrp.Position
        ToggleNoclip(true)
        setupAntiSeat()
        setRemoteCrouch(true)
        hrp.Anchored = false 

        local proxy = Instance.new("Part")
        proxy.Anchored = true
        proxy.Transparency = 1
        proxy.CanCollide = false
        proxy.CFrame = hrp.CFrame
        proxy.Parent = Workspace

        -- Placa Maior e Sólida (12x12)
        local safePlate = Instance.new("Part")
        safePlate.Size = Vector3.new(12, 0.2, 12) 
        safePlate.Transparency = 0.3
        safePlate.Color = Color3.fromRGB(255, 50, 50)
        safePlate.Material = Enum.Material.Neon
        safePlate.CanCollide = true 
        safePlate.Anchored = true
        safePlate.Parent = Workspace 

        local updateConnection = RunService.Heartbeat:Connect(function()
            if hrp and proxy then
                hrp.CFrame = proxy.CFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                if safePlate and safePlate.Parent then
                    safePlate.CFrame = proxy.CFrame * CFrame.new(0, -3.1, 0)
                end
            end
        end)

        -- PASSO 1: Afunda suavemente até a camada UNDERGROUND_Y (-5)
        local subPos = Vector3.new(originalPos.X, UNDERGROUND_Y, originalPos.Z)
        tweenTo(proxy, CFrame.new(subPos))

        -- PASSO 2: Loop Principal de Perseguição e Combate
        while autoPunchActive or priorityTarget do
            local currentTarget = priorityTarget
            
            if not currentTarget or not isValidTarget(currentTarget) then
                priorityTarget = nil
                currentTarget = getClosestTarget(proxy.Position)
            end

            if currentTarget then
                local tChar = currentTarget.Character
                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")
                
                if tHrp and tHum then
                    -- Vai debaixo da terra até o X e Z do alvo
                    while (autoPunchActive or priorityTarget) and isValidTarget(currentTarget) do
                        if isInCar(currentTarget) then break end 
                        
                        local dest = Vector3.new(tHrp.Position.X, UNDERGROUND_Y, tHrp.Position.Z)
                        local dist = (proxy.Position - dest).Magnitude
                        if dist < 3 then break end 
                        
                        if not priorityTarget then
                            local closer = getClosestTarget(proxy.Position)
                            if closer and closer ~= currentTarget then
                                local cHrp = closer.Character:FindFirstChild("HumanoidRootPart")
                                if cHrp then
                                    local cDist = (Vector3.new(cHrp.Position.X, UNDERGROUND_Y, cHrp.Position.Z) - proxy.Position).Magnitude
                                    if cDist < dist - 15 then 
                                        currentTarget = closer
                                        tChar = currentTarget.Character
                                        tHrp = tChar:FindFirstChild("HumanoidRootPart")
                                        tHum = tChar:FindFirstChild("Humanoid")
                                    end
                                end
                            end
                        end

                        tweenTo(proxy, CFrame.new(dest))
                    end

                    -- MOMENTO DO SOCO: Fica na altura correta logo abaixo do alvo
                    if isValidTarget(currentTarget) and not isInCar(currentTarget) then
                        while (autoPunchActive or priorityTarget) and isValidTarget(currentTarget) and not isInCar(currentTarget) do
                            if not tHrp or not tHrp.Parent or not tHum or tHum.Health <= 0 then break end
                            
                            -- Se o alvo pular, travamos na última posição e altura
                            if not isJumping(tHum) then
                                local targetFeetY = tHrp.Position.Y - 3.2
                                local alignPos = Vector3.new(tHrp.Position.X, targetFeetY, tHrp.Position.Z)
                                proxy.CFrame = CFrame.new(alignPos)
                            end
                            
                            doPunch(currentTarget)
                            task.wait(0.08)
                        end
                        
                        if priorityTarget == currentTarget then priorityTarget = nil end
                    end
                end
            else
                -- Caso não tenha nenhum alvo, fica seguro na posição inicial subterrânea aguardando
                local homeSub = Vector3.new(originalPos.X, UNDERGROUND_Y, originalPos.Z)
                if (proxy.Position - homeSub).Magnitude > 2 then
                    tweenTo(proxy, CFrame.new(homeSub))
                else
                    task.wait(0.3)
                end
            end
        end

        -- ==================================================
        -- DESLIGOU: RETORNO SUAVE PARA A POSIÇÃO ORIGINAL
        -- ==================================================
        if currentTween then currentTween:Cancel() end
        setRemoteCrouch(false)
        
        -- 1. Vai por baixo até a vertical da posição original
        local returnSubPos = Vector3.new(originalPos.X, UNDERGROUND_Y, originalPos.Z)
        tweenTo(proxy, CFrame.new(returnSubPos))
        
        -- 2. Sobe suavemente para a posição exata onde você ativou
        tweenTo(proxy, CFrame.new(originalPos))

        -- Limpeza
        updateConnection:Disconnect()
        if currentTween then currentTween:Cancel() end
        if antiSeatConnection then antiSeatConnection:Disconnect() end
        proxy:Destroy()
        safePlate:Destroy()
        hrp.Anchored = false
        ToggleNoclip(false)
        engineRunning = false
    end)
end

